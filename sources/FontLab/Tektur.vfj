        "feature":"#> classes\n#/> otclasses\n@CombiningTopAccents = [gravecomb acutecomb uni0302 uni030C uni0311 uni0306 tildecomb uni0308 uni0307 uni030A uni030B uni030F uni0304 uni0312 uni0312 hookabovecomb gravecomb.i acutecomb.i];\n@loclBGR_0 = [uni0414 uni041B uni0424 uni0432 uni0433 uni0434 uni0436 uni0437 uni0438 uni0439 uni045D uni043A uni043B uni043F uni0442 uni0446 uni0448 uni0449 uni044A uni044C uni044E];\n@loclBGR_1 = [uni0414.loclBGR uni041B.loclBGR uni0424.loclBGR uni0432.loclBGR uni0433.loclBGR uni0434.loclBGR uni0436.loclBGR uni0437.loclBGR uni0438.loclBGR uni0439.loclBGR uni045D.loclBGR uni043A.loclBGR uni043B.loclBGR uni043F.loclBGR uni0442.loclBGR uni0446.loclBGR uni0448.loclBGR uni0449.loclBGR uni044A.loclBGR uni044C.loclBGR uni044E.loclBGR];\n@grek_UC = [Alpha Beta Gamma uni0394 Epsilon Zeta Eta Theta Iota Kappa Lambda Mu Nu Xi Omicron Pi Rho Sigma Tau Upsilon Phi Chi Psi uni03A9 Alphatonos Epsilontonos Etatonos Iotatonos Iotadieresis Omicrontonos Upsilontonos Upsilondieresis Omegatonos Omicron_Upsilon];\n@grek_lc = [alpha beta gamma delta epsilon zeta eta theta iota kappa lambda uni03BC nu xi omicron pi rho uni03C2 sigma tau upsilon phi chi psi omega alphatonos epsilontonos etatonos iotatonos iotadieresis iotadieresistonos omicrontonos upsilontonos upsilondieresis upsilondieresistonos omegatonos gamma_gamma lambda_lambda];\n@grek_UC_tonos = [Alphatonos Epsilontonos Etatonos Iotatonos Omicrontonos Upsilontonos Omegatonos];\n@grek_UC_tonosless = [Alpha Epsilon Eta Iota Omicron Upsilon uni03A9];\n@loclSRB_0 = [uni0431];\n@loclSRB_1 = [uni0431.loclSRB];\n#/< otclasses\n#< classes\n\nlanguagesystem DFLT dflt;\nlanguagesystem latn dflt;\nlanguagesystem latn CAT;\nlanguagesystem latn NLD;\n\nlanguagesystem cyrl dflt;\nlanguagesystem cyrl BGR;\nlanguagesystem cyrl SRB;\n\nlanguagesystem grek dflt;\n"
      },
      {
        "name":"ccmp",
        "feature":"feature ccmp {\n  sub [i j iogonek uni0268 uni0456 uni0458 uni1ECB]' [uni031B uni0326 uni0327 uni0328 dotbelowcomb uni0329 uni0331] @CombiningTopAccents by [dotlessi uni0237 iogonek.dotless uni0268.dotless dotlessi uni0237 uni1ECB.dotless];\n  sub [i j iogonek uni0268 uni0456 uni0458 uni1ECB]' @CombiningTopAccents by [dotlessi uni0237 iogonek.dotless uni0268.dotless dotlessi uni0237 uni1ECB.dotless];\n  sub [dotlessi uni0237 iogonek.dotless uni0268.dotless dotlessi] [ acutecomb gravecomb ]' by [ acutecomb.i gravecomb.i ];\n} ccmp;\n"
      },
      {
        "name":"locl",
        "feature":"feature locl {\nscript latn;\n\nlanguage CAT;\nlookup loclCAT {\n  sub L periodcentered' L by periodcentered.loclCAT.cap;\n  sub l periodcentered' l by periodcentered.loclCAT;\n} loclCAT;\n\nlanguage NLD;\nsub iacute j' by jacute;\nsub Iacute J' by Jacute;\n\n\nscript cyrl;\nlanguage BGR;\nsub @loclBGR_0 by @loclBGR_1;\nlanguage SRB;\nsub @loclSRB_0 by @loclSRB_1;\n\n} locl;\n"
      },
      {
        "name":"calt",
        "feature":"feature calt {\n\nscript grek;\n\n@grekAll = [ @grek_UC @grek_lc ] ;\n\n@whitespace = [ space uni2007 uni2008 uni2009 uni200A ];\n@dashes = [ hyphen figuredash endash emdash uni2015 ] ;\n@quoteHigh = [ quotesingle quotedbl quoteleft quotedblleft quoteright quotedblright ] ;\n@quoteLow = [ quotedblbase quotesinglbase ] ;\n@punctuation = [ @quoteHigh @quoteLow @dashes comma period semicolon colon uni037E exclam question ] ;\n@non_letter = [ @whitespace @punctuation];\n\nlookup grek_dialytikaInsertion {\n\tscript grek;\n\tsub [Alphatonos Epsilontonos Omicrontonos Upsilontonos] Iota' by Iotadieresis;\n\tsub [Alphatonos Epsilontonos Omicrontonos] Upsilon' by Upsilondieresis;\n} grek_dialytikaInsertion;\n\nlookup grek_tonosSuppression {\n# tonos supression of single-letter word\n  sub @grek_UC_tonos' @non_letter @non_letter @non_letter @non_letter @non_letter @grek_UC by @grek_UC_tonosless;\n  sub @grek_UC_tonos' @non_letter @non_letter @non_letter @non_letter @grek_UC by @grek_UC_tonosless;\n  sub @grek_UC_tonos' @non_letter @non_letter @non_letter @grek_UC by @grek_UC_tonosless;\n  sub @grek_UC_tonos' @non_letter @non_letter @grek_UC by @grek_UC_tonosless;\n  sub @grek_UC_tonos' @non_letter @grek_UC by @grek_UC_tonosless;\n  sub @grek_UC @non_letter @non_letter @non_letter @non_letter @non_letter @grek_UC_tonos' by @grek_UC_tonosless;\n  sub @grek_UC @non_letter @non_letter @non_letter @non_letter @grek_UC_tonos' by @grek_UC_tonosless;\n  sub @grek_UC @non_letter @non_letter @non_letter @grek_UC_tonos' by @grek_UC_tonosless;\n  sub @grek_UC @non_letter @non_letter @grek_UC_tonos' by @grek_UC_tonosless;\n  sub @grek_UC @non_letter @grek_UC_tonos' by @grek_UC_tonosless;\n  # tonos supression within a word\n  sub   @grek_UC @grek_UC_tonos' by @grek_UC_tonosless;\n  sub   @grek_UC_tonos' @grek_UC by @grek_UC_tonosless;\n} grek_tonosSuppression;\n\nlookup anoteleia {\n\tignore sub @grekAll periodcentered' @grekAll;\n\tsub @grekAll periodcentered' by anoteleia;\n} anoteleia;\n\n} calt;\n"
      },
      {
